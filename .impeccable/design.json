{
  "version": 1,
  "tokens": {
    "--bg": "#0A0B09",
    "--hover": "#13150E",
    "--raise": "#10120C",
    "--line": "#2A2D25",
    "--muted": "#8A8F80",
    "--soft": "#C4C9BC",
    "--fg": "#E9EBE2",
    "--green": "#C6FF4A",
    "--green-deep": "#9CE61F",
    "--gold": "#F2B93B",
    "--gold-hi": "#FFE3A1",
    "--bad": "#FF5C4D"
  },
  "fontFamilies": {
    "--text": "JetBrains Mono",
    "--label": "Space Grotesk",
    "--head": "Bodoni Moda"
  },
  "motion": {
    "curve": "cubic-bezier(0.23, 1, 0.32, 1)",
    "maxDurationMs": 300,
    "rule": "transform and opacity only; no box-shadow or blur animation; reduced-motion fades only; reduced-transparency solid glass"
  },
  "accentRules": [
    "max 3-4 visible phosphor points at once",
    "decorative phosphor only on hover/focus/active/state",
    "ambient phosphor below 0.12 opacity",
    "good-note color is semantic, not decoration"
  ]
}